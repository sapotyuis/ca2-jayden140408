# Dependencies
node_modules

# Frontend build artefacts
dist
frontend/dist

# Environment variables — never commit secrets (JWT_SECRET_KEY).
# Copy .env.example to .env and fill it in locally.
.env

# Local database — regenerate it with `npm run db`.
# Binary file that changes on every seed and every play session, so tracking it
# would churn on every commit and conflict on every merge.
local.db
local.db-journal
*.sqlite
*.sqlite3

# OS files
.DS_Store
Thumbs.db

# IDE
.vscode
.idea

# Logs
*.log

# Test coverage
coverage

# Generated API docs — swagger-autogen rewrites this on every server boot
_extras/api-docs/swagger-output.json

# Drizzle migrations
drizzle

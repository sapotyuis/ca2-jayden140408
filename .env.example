# Copy this file to `.env` and fill in the values before running the server.
#   cp .env.example .env

# Server port
PORT=3000

# libsql connection string
DATABASE_URL=file:local.db
# Required only for remote libSQL/Turso databases.
DATABASE_AUTH_TOKEN=

# Environment mode
NODE_ENV=development

# JWT settings
# JWT_SECRET_KEY signs every login token — set it to a long random string.
# Anyone who knows this value can forge a token for any user, so it must never be committed.
JWT_SECRET_KEY=replace-me-with-a-long-random-string
JWT_EXPIRES_IN=1h
JWT_ALGORITHM=HS256
